#if commentout not save EEW log data
logdir: ./eewlog

# irc: is a list, so you can notify multiple IRC servers. Omit it entirely
# (or leave it an empty list) to disable IRC notification.
irc:
 - server:
    host: irc.example.jp
    port: 6667
#   password: hoge
#   charset defaults to utf-8 if omitted; set to iso-2022-jp for servers/
#   channels that still expect that encoding.
#   charset: iso-2022-jp
#   message-type defaults to notice; set to privmsg if you'd rather it
#   stand out more in clients that dim/hide notices.
#   message-type: privmsg
   nick: EEWNotice
   name: EEWBot
   desc: Emergency Earthquake Warning
#  channel,post all EEW messages
   all-notice:
    - "#all"
    - "#whole"
#  channel,post first/final/cancellation EEW messages only
   limited-notice:
    - "#limited"
    - "#sukoshi"

slack:
 all:
  - a: https://www.example.com/api/webhook
  - https://www.example.org/api/webhook
  - hoge: https://www.example.org/api/webhook
 limited:
  - p: https://www.example.net/api/webhook
  - https://www.example.jp/api/webhook

WNIEEW:
 user: username
 passwd: bar
# Logs:
#  Timeout: 1
#  KeepAlive: 1
# if you don't want to write plain-password, set md5_hex(your password);
# passwd-md5: md5hashedpassword
