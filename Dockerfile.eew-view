# Dockerfile.eew-view — the EEW archive viewer (cmd/eew-view). Build
# context must be the repo root so the builder stage can see
# go.mod/internal/.
#
# FROM scratch, same rationale as Dockerfile: CGO_ENABLED=0 already
# produces a fully static binary. Two differences from Dockerfile:
# - No CA-cert copy: this binary makes no outbound TLS calls at all — it
#   only reads local files and serves HTTP.
# - EXPOSE 8080: this binary listens for inbound connections, unlike the
#   notifier.
# The image also carries cmd/eew-pack (packs a closed year of the archive
# into <logdir>/<YYYY>.zip), so a one-off Job/CronJob can run it from this
# image with the same UID as the notifier that wrote the files:
# command: ["/usr/src/eew-view/eew-pack", "-dir", "/eewlog", "-year", "2025"]

FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/eew-view ./cmd/eew-view
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/eew-pack ./cmd/eew-pack

FROM scratch
# Left root-owned (no --chown) so the runtime user (1000:1000, below) can
# execute it but not modify it.
COPY --from=builder /out/eew-view /usr/src/eew-view/eew-view
COPY --from=builder /out/eew-pack /usr/src/eew-view/eew-pack

ENV TZ=Asia/Tokyo
USER 1000:1000
WORKDIR /usr/src/eew-view
EXPOSE 8080

ENTRYPOINT [ "./eew-view" ]
