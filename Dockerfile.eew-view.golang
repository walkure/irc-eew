# Dockerfile.eew-view.golang — Go port of the EEW archive viewer
# (HTML/index.pl + HTML/eew-show.pl). Build context must be the repo root
# (not ./HTML/) so the builder stage can see go.mod/internal/.
#
# FROM scratch, same rationale as Dockerfile.golang: CGO_ENABLED=0 already
# produces a fully static binary. Two differences from Dockerfile.golang:
# - No CA-cert copy: this binary makes no outbound TLS calls at all (no
#   Slack, no WNI) — it only reads local files and serves HTTP.
# - EXPOSE 8080: this binary listens for inbound connections, unlike the
#   notifier.
#
# Once the Go port replaces the Perl original in production, this file
# loses the ".golang" suffix and HTML/ (index.pl, eew-show.pl, Dockerfile,
# lighttpd.conf) can be retired.

FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/eew-view ./cmd/eew-view

FROM scratch
# Left root-owned (no --chown) so the runtime user (1000:1000, below) can
# execute it but not modify it.
COPY --from=builder /out/eew-view /usr/src/eew-view/eew-view

ENV TZ=Asia/Tokyo
USER 1000:1000
WORKDIR /usr/src/eew-view
EXPOSE 8080

ENTRYPOINT [ "./eew-view" ]
